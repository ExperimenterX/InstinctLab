# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Composer: authors the LabSpec. Needs the strongest reasoning.
INSTINCT_MODEL_COMPOSER=claude-opus-5
# Planner / coach / grader: fast turnarounds, called many times per session.
INSTINCT_MODEL_PLANNER=claude-sonnet-5
INSTINCT_MODEL_COACH=claude-sonnet-5
INSTINCT_MODEL_GRADER=claude-sonnet-5

# ── Generation budgets (hard ceilings, enforced in ai-core/guards/budget.ts) ──
INSTINCT_MAX_SPEC_TOKENS=16000
INSTINCT_MAX_REPAIR_ATTEMPTS=2
INSTINCT_SPEC_TIMEOUT_MS=45000
INSTINCT_COACH_TIMEOUT_MS=8000

# ── Persistence ───────────────────────────────────────────────────────────────
# memory | sqlite | redis
INSTINCT_PERSISTENCE=memory
INSTINCT_SQLITE_PATH=./.data/instinct.db
REDIS_URL=

# ── Session policy ────────────────────────────────────────────────────────────
INSTINCT_SESSION_TTL_SECONDS=86400
INSTINCT_EVENT_BATCH_MAX=64
INSTINCT_RATE_LIMIT_LABS_PER_HOUR=20

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
